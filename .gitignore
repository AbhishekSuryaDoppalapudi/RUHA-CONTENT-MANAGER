.venv/
__pycache__/
*.py[cod]
.env
# legacy Streamlit MVP storage
storage/uploads/*
storage/projects/*
storage/temp/*
!storage/uploads/.gitkeep
!storage/projects/.gitkeep
!storage/temp/.gitkeep
# El Ruach Manager runtime data (databases, videos, generated files, backups) - never commit
ruha_data/
# portable Node used only to build the UI, and build output
tools/
frontend/node_modules/
frontend/dist/
.pytest_cache/

# a separate project (the shared dubbing/translation engine) kept alongside RUHA; it has its own git history
external/

# generated by scripts/reframe_check.py and scripts/e2e_full_sermon.py
scripts/reframe_out/
scripts/e2e_report_*.json
