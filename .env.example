# El Ruach Manager configuration (copy to .env; every line is optional)

# Where everything is stored: database, project folders, brand files, backups, logs.
# Default: the "ruha_data" folder next to this file.
# RUHA_DATA_DIR=D:\RUHA-data

RUHA_HOST=127.0.0.1
RUHA_PORT=8765
RUHA_MAX_UPLOAD_GB=20

# The ONE El Ruach Video Translator folder (dubbing_engine.py + compat.py; keeps its own .venv).
# RUHA never imports its app.py: the dubbing worker calls dubbing_engine, the YouTube narration worker calls compat.
RUHA_TRANSLATOR_DIR=C:\Dev\indic-video-translator
# RUHA_TRANSLATOR_PYTHON=C:\Dev\indic-video-translator\.venv\Scripts\python.exe

# Models, quality, GPU/CPU, subtitle style etc. are changed inside the app
# (Processing Centre / Settings) and stored in the database - not here.

# --- used only by the legacy Streamlit MVP (run.bat) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
